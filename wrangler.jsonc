{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "7iamir",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "7iamir-db",
      "database_id": "c1008bc4-d7e5-4e47-bc13-c3641caa0ba8"
    }
  ]
}
